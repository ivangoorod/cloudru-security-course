# Скопируйте в ~/.cloudru.env, заполните и подключайте перед запуском Terraform:
#   cp cloudru.env.example ~/.cloudru.env && chmod 600 ~/.cloudru.env
#   source ~/.cloudru.env
# Ключ доступа сервисного аккаунта: консоль cloud.ru → Пользователи → Сервисные аккаунты → <аккаунт> → Ключи доступа
export AUTH_KEY_ID=""
export AUTH_SECRET=""
# ID проекта: главная страница консоли, кнопка копирования рядом с «ID проекта»
export TF_VAR_project_id=""
